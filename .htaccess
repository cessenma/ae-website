# ===========================================================
# American English 埃森美語 — static site (Apache/LiteSpeed)
# Directory-style clean URLs (/courses/ -> /courses/index.html)
# NO rewrite/redirect rules needed — every page is a real folder,
# served natively by DirectoryIndex. Same URLs as old WordPress,
# so no migration 301s. Also works as-is on Netlify / Cloudflare
# Pages / GitHub Pages (which ignore .htaccess but do the same thing).
# ===========================================================

Options -Indexes
DirectoryIndex index.html

# Force HTTPS (standard hardening — Hostinger may already do this at
# the platform level; harmless if duplicated).
<IfModule mod_rewrite.c>
RewriteEngine On
# Canonical host: force https + non-www in a single 301 hop.
# (GSC showed http://www.americanenglish.com.tw/ indexed separately — ~2,509 imp at 0.4% CTR —
#  splitting ranking signals from the real non-www site. Purge Cloudflare cache after deploy.)
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://americanenglish.com.tw%{REQUEST_URI} [L,R=301]
</IfModule>

# SEO consolidation 301 (cannibalization fix): /banqiao-junior-high-english/
# merged into /junior-high-english-banqiao/. Trailing slash keeps the
# -blind-spots article unaffected. Purge Cloudflare cache for the old URL after deploy.
Redirect 301 /banqiao-junior-high-english/ https://americanenglish.com.tw/junior-high-english-banqiao/

# Legacy URLs that still 404 but remain indexed (per GSC: /en/ 201 imp, /en/courses 198 imp,
# /american-english-file 155 imp). Anchored RedirectMatch so /english-* slugs are NOT affected.
RedirectMatch 301 ^/en/courses/?$ https://americanenglish.com.tw/courses/
RedirectMatch 301 ^/en/?$ https://americanenglish.com.tw/
RedirectMatch 301 ^/american-english-file/?$ https://americanenglish.com.tw/courses/

# More legacy WordPress URLs surfaced in GSC (Jun 2026) — 301 to the closest
# current page so their residual impressions are recovered instead of 404ing.
# Anchored (^...$) so live slugs (e.g. /elementary-english-*) are never caught.
RedirectMatch 301 ^/explore-our-world/?$ https://americanenglish.com.tw/courses/
RedirectMatch 301 ^/project-explorer/?$ https://americanenglish.com.tw/courses/
RedirectMatch 301 ^/aei-curriculum/?$ https://americanenglish.com.tw/courses/
RedirectMatch 301 ^/elementary-school-students/?$ https://americanenglish.com.tw/banqiao-elementary-school-english/
RedirectMatch 301 ^/about/?$ https://americanenglish.com.tw/certified-american-teacher-banqiao/
RedirectMatch 301 ^/information/?$ https://americanenglish.com.tw/
# GA4 Jul 2026: visitors (and the month's only tracked key events) still hit the
# old WordPress /contact-us — send them to the trial page instead of a 404.
RedirectMatch 301 ^/contact-us/?$ https://americanenglish.com.tw/free-trial/
# Retired /en/ section: map the known pages, then send everything else under
# /en/ (incl. /en/explore-our-world-info, which was returning 403) to home.
RedirectMatch 301 ^/en/american-english-file-info/?$ https://americanenglish.com.tw/courses/
RedirectMatch 301 ^/en/explore-our-world-info/?$ https://americanenglish.com.tw/courses/
RedirectMatch 301 ^/en/elementary-school-students/?$ https://americanenglish.com.tw/banqiao-elementary-school-english/
RedirectMatch 301 ^/en/about/?$ https://americanenglish.com.tw/certified-american-teacher-banqiao/
RedirectMatch 301 ^/en/ https://americanenglish.com.tw/

# Friendly 404
ErrorDocument 404 /404.html

# Agent discovery (RFC 8288) — advertise the machine-readable site summary (llms.txt)
# so AI agents/crawlers can find a curated description of the business.
<IfModule mod_headers.c>
Header set Link "</llms.txt>; rel=describedby"
# Security headers (HSTS without 'preload' to keep it reversible; add ; preload only if you commit to the HSTS preload list)
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
# HTML: let Cloudflare cache it briefly (5 min) but never serve stale pages for
# days — the edge was caching blog HTML with no cache-control and picking its
# own long TTL, so deploys took days to appear in some regions.
# 'no-transform' stops Cloudflare injecting its JS-Detections script
# (/cdn-cgi/challenge-platform/scripts/jsd/main.js) into every HTML response.
# That script was the #1 JS execution item on the site (~600ms mobile) and caused all
# three deprecated-API warnings that held Best Practices at 82. JS Detections cannot be
# switched off on the Free plan; no-transform is the supported way to opt out.
# Safe here because NO other Cloudflare transformation is in use — verified live 2026-08-07:
# 0 Email Obfuscation, 0 Rocket Loader, 0 Web Analytics beacon, no auto-minify.
# Scoped to .html so CSS/JS/image handling is untouched.
#
# NOTE: a Cloudflare Response Header Transform Rule ("HTML no-transform (stop JSD
# injection)", filter: http.request.uri.path wildcard r"*/") sets the SAME header at the
# edge and is what actually takes effect today. This origin copy is a deliberate fallback
# so the behaviour survives if that rule is deleted or the site moves off Cloudflare.
# If you change one, change both — they must not drift apart.
# Verified live after deploy: jsd script gone (0 refs), content-encoding still 'br'.
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=0, s-maxage=300, must-revalidate, no-transform"
</FilesMatch>
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml
</IfModule>

# Serve WebP with the correct MIME type
AddType image/webp .webp
