# Listening audio. Some hosts guess audio/mp4a-latm for .m4a, which browsers
# refuse to play — pin the container type and let the files cache hard.
/assets/audio/*
  Content-Type: audio/mp4
  Cache-Control: public, max-age=31536000, immutable

# Private pack delivery. robots.txt can be ignored; this header cannot.
/pack-x5jhfyn0oooljh/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
