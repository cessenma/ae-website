 "css": ".rv-box{max-width:860px;margin:0 auto 34px;padding:22px 22px 18px;border-radius:22px;background:var(--light-blue);box-shadow:inset 0 0 0 1px rgba(26,39,82,.08)}.rv-h{font-size:20px;line-height:1.5;color:var(--navy);margin:0 0 8px}.rv-p{font-size:15px;line-height:1.8;color:#374151;margin:0 0 14px}.rv-q{width:100%;max-width:340px;font:inherit;font-size:16px;padding:10px 14px;border:2px solid var(--navy);border-radius:12px;background:#fff;color:var(--navy);margin-bottom:14px}.rv-list{display:grid;gap:8px;max-height:380px;overflow-y:auto;overscroll-behavior:contain;padding-right:4px}.rv-l{display:grid;grid-template-columns:28px 1fr;gap:8px;align-items:start}.rv-l[hidden],.rv-e[hidden]{display:none}.rv-k{font-weight:800;color:var(--blue-ink);font-size:16px;line-height:30px}.rv-es{display:flex;flex-wrap:wrap;gap:6px}.rv-e{display:inline-flex;gap:6px;align-items:baseline;background:#fff;border-radius:10px;padding:4px 10px;font-size:15px;line-height:22px;color:#374151}.rv-e b{color:var(--navy);font-weight:700}.rv-none{font-size:15px;line-height:1.8;color:#374151;margin:6px 0 0}@media(max-width:600px){.rv-box{padding:18px 14px 14px;border-radius:18px}.rv-h{font-size:18px}.rv-list{max-height:340px}.rv-q{max-width:none}.rv-e{font-size:14px;padding:3px 8px}}"
}